<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Calculator" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/btn_operator</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
    </style>

    <style name="CalcButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_margin">2dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">50dp</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="CalcButton.Digit" parent="CalcButton">
        <item name="backgroundTint">@color/btn_digit</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="CalcButton.Function" parent="CalcButton">
        <item name="backgroundTint">@color/btn_function</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="CalcButton.Operator" parent="CalcButton">
        <item name="backgroundTint">@color/btn_operator</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="CalcButton.Equals" parent="CalcButton">
        <item name="backgroundTint">@color/btn_operator</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>